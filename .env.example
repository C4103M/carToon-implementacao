# ==============================================================================
# CarToon - Configuracao de Ambiente (Local e AWS)
# Copie este arquivo para .env no ambiente local. Na AWS, injete via SSM / Secrets Manager.
# ==============================================================================

# Perfil Spring Boot: 'dev' (local, com DadosIniciais e Swagger) | 'prod' (AWS, ddl-auto=validate)
SPRING_PROFILES_ACTIVE=dev

# Banco de dados PostgreSQL
# Local (Docker Compose): jdbc:postgresql://db:5432/oficina
# AWS (RDS): jdbc:postgresql://<endpoint-rds>:5432/oficina?sslmode=require
DB_URL=jdbc:postgresql://db:5432/oficina
DB_USER=oficina_master
DB_PASSWORD=oficina_password

# PgAdmin (opcional no Compose local)
PG_ADMIN_EMAIL=dev@email.com
PG_ADMIN_PASSWORD=123

# Seguranca e JWT (use uma chave aleatoria de >= 256 bits em producao)
JWT_SECRET=substitua-por-uma-chave-secreta-aleatoria-com-no-minimo-256-bits
# Local (HTTP): false | AWS (HTTPS via ALB/CloudFront): true
APP_SECURITY_COOKIE_SECURE=false
# Origens CORS separadas por virgula (opcional quando usado Same-Origin via ALB/Next.js)
CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]

# Integracao Tabela FIPE (opcional para aumentar rate limit)
FIPE_TOKEN=

# Bootstrap do primeiro SUPERADMIN (usado apenas quando SPRING_PROFILES_ACTIVE=prod e nao ha SUPERADMIN)
BOOTSTRAP_SUPERADMIN_NOME=Super Administrador
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=

# Frontend
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false

# Producao (EC2 + Caddy + docker-compose.prod.yml)
# Use ':80' para testes via IP HTTP (com APP_SECURITY_COOKIE_SECURE=false)
# ou 'app.seudominio.com.br' para HTTPS automatico (com APP_SECURITY_COOKIE_SECURE=true)
DOMAIN=:80
API_IMAGE=ghcr.io/c4103m/cartoon-api:latest
FRONTEND_IMAGE=ghcr.io/c4103m/cartoon-frontend:latest
