{
  "info": {
    "_postman_id": "e0d11147-db11-43de-bd11-cf9261cfa916",
    "name": "CarToon - Usuários (ADMIN e MECANICO)",
    "description": "Rodar com o Runner, na ordem. Pré-requisitos: banco no ar e API com perfil dev (o seeder cria superadmin@teste.com, admin@teste.com e mecanico@teste.com, senha senha123). A autenticação é por cookie jwt: o Postman reenvia o cookie sozinho. Regras testadas: SUPERADMIN cria ADMIN; ADMIN cria MECANICO na própria oficina; ninguém cria SUPERADMIN pela API; perfil e oficina nunca vêm do body. Cada rodada gera e-mails únicos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "0 - Login (SUPERADMIN)",
      "item": [
        {
          "name": "00 - Login como SUPERADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Guarda o cookie jwt. Sem login, as rotas de usuário respondem 403.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailSuper}}\",\n  \"password\": \"{{senhaTeste}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Cookie jwt recebido', function () {",
                  "    var c = pm.response.headers.get('Set-Cookie');",
                  "    pm.expect(c).to.be.a('string');",
                  "    pm.expect(c).to.include('jwt=');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "01 - Preparo: descobrir a oficina do seeder",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/oficina",
            "description": "Gera e-mails únicos para esta rodada e guarda o id da oficina de menor id (a do seeder, onde ficam admin@teste.com e mecanico@teste.com)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('emailNovoAdmin', 'admin.' + ts + '@teste.com');",
                  "pm.collectionVariables.set('emailNovoMecanico', 'mec.' + ts + '@teste.com');",
                  "pm.collectionVariables.set('emailMecanicoDoSeed', 'mecseed.' + ts + '@teste.com');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var lista = pm.response.json();",
                  "pm.test('Há ao menos uma oficina', function () {",
                  "    pm.expect(lista.length).to.be.above(0);",
                  "});",
                  "var menor = lista.reduce(function (a, b) { return a.id < b.id ? a : b; });",
                  "pm.collectionVariables.set('oficinaSeedId', menor.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "A - SUPERADMIN cria ADMIN",
      "item": [
        {
          "name": "02 - Criar ADMIN (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/usuario/admin",
            "description": "Só o SUPERADMIN cria ADMIN. O perfil vem da rota, nunca do body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Admin Teste\",\n  \"email\": \"{{emailNovoAdmin}}\",\n  \"senha\": \"{{senhaNova}}\",\n  \"oficinaId\": {{oficinaSeedId}}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var json = pm.response.json();",
                  "pm.test('Role é ADMIN', function () { pm.expect(json.role).to.eql('ADMIN'); });",
                  "pm.test('Vinculado à oficina informada', function () { pm.expect(json.oficinaId).to.eql(parseInt(pm.collectionVariables.get('oficinaSeedId'))); });",
                  "pm.test('Tem id e e-mail', function () {",
                  "    pm.expect(json.id).to.be.a('number');",
                  "    pm.expect(json.email).to.eql(pm.collectionVariables.get('emailNovoAdmin'));",
                  "});",
                  "pm.test('Resposta não expõe a senha', function () {",
                  "    pm.expect(pm.response.json()).to.not.have.property('senha');",
                  "});"
                ]
              }
            }
          ]
        },
