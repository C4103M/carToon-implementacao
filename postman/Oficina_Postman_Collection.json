{
  "info": {
    "name": "CarToon - Oficina API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rodar com o Runner, na ordem. Pre-requisitos: banco no ar, API com perfil dev (o seeder cria superadmin@teste.com, admin@teste.com e mecanico@teste.com, senha senha123). A autenticacao e por cookie jwt: a pasta 0 faz o login como SUPERADMIN e o Postman reenvia o cookie sozinho. A pasta E testa os papeis ADMIN e MECANICO. Cada rodada gera nome e telefone unicos."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "senhaTeste",
      "value": "senha123"
    },
    {
      "key": "emailSuper",
      "value": "superadmin@teste.com"
    },
    {
      "key": "emailAdmin",
      "value": "admin@teste.com"
    },
    {
      "key": "emailMecanico",
      "value": "mecanico@teste.com"
    },
    {
      "key": "oficinaId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "0 - Login (SUPERADMIN)",
      "item": [
        {
          "name": "00 - Login como SUPERADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "description": "Guarda o cookie jwt no Postman. Sem este passo, todas as rotas de oficina respondem 403.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{emailSuper}}\",\n  \"password\": \"{{senhaTeste}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Cookie jwt recebido', function () {",
                  "    var c = pm.response.headers.get('Set-Cookie');",
                  "    pm.expect(c).to.be.a('string');",
                  "    pm.expect(c).to.include('jwt=');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "A - Fluxo sem Erros",
      "item": [
        {
          "name": "01 - Listar oficinas ativas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Retorna array com ao menos 1 oficina', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j).to.be.an('array');",
                  "    pm.expect(j.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/oficina",
            "description": "Exige perfil dev ativo (o seeder cria a oficina id 1)."
          }
        },
        {
          "name": "02 - Criar oficina valida",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rnd = function () { return '119' + Math.floor(10000000 + Math.random() * 90000000); };",
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('nomeUnico', 'Oficina Teste ' + ts);",
                  "pm.collectionVariables.set('telefoneUnico', rnd());",
                  "pm.collectionVariables.set('nomeAtualizado', 'Oficina Atualizada ' + ts);",
                  "pm.collectionVariables.set('telefoneAtualizado', rnd());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var j = pm.response.json();",
                  "",
                  "pm.test('Retornou id e nasceu ativa', function () {",
                  "    pm.expect(j).to.have.property('id');",
                  "    pm.expect(j.ativo).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Nome confere', function () {",
                  "    pm.expect(j.nome).to.eql(pm.collectionVariables.get('nomeUnico'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('oficinaId', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/oficina",
            "description": "Gera nome e telefone unicos a cada rodada e guarda o id em {{oficinaId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeUnico}}\",\n  \"endereco\": \"Rua das Flores, 200\",\n  \"telefone\": \"{{telefoneUnico}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "03 - Buscar por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Id confere', function () {",
                  "    pm.expect(pm.response.json().id).to.eql(parseInt(pm.collectionVariables.get('oficinaId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/oficina/{{oficinaId}}",
            "description": ""
          }
        },
