                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/oficina/{{oficinaId}}/ativar",
            "description": ""
          }
        },
        {
          "name": "11 - Listar: reativada volta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Oficina reativada na lista', function () {",
                  "    var ids = pm.response.json().map(function (o) { return o.id; });",
                  "    pm.expect(ids).to.include(parseInt(pm.collectionVariables.get('oficinaId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/oficina",
            "description": ""
          }
        }
      ]
    },
