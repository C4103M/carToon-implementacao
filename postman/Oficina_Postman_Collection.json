{
  "info": {
    "name": "CarToon - Oficina API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rodar com o Runner, na ordem. Pre-requisitos: banco no ar e API com perfil dev. Cada rodada gera nome e telefone unicos."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "username",
      "value": "user"
    },
    {
      "key": "password",
      "value": "cole-a-senha-do-log-aqui"
    },
    {
      "key": "oficinaId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "A - Fluxo sem Erros",
      "item": [
        {
          "name": "01 - Listar oficinas ativas",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Retorna array com ao menos 1 oficina', function () {",
                  "    var j = pm.response.json();",
                  "    pm.expect(j).to.be.an('array');",
                  "    pm.expect(j.length).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/oficina",
            "description": "Exige perfil dev ativo (o seeder cria a oficina id 1)."
          }
        },
        {
          "name": "02 - Criar oficina valida",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rnd = function () { return '119' + Math.floor(10000000 + Math.random() * 90000000); };",
                  "const ts = Date.now();",
                  "pm.collectionVariables.set('nomeUnico', 'Oficina Teste ' + ts);",
                  "pm.collectionVariables.set('telefoneUnico', rnd());",
                  "pm.collectionVariables.set('nomeAtualizado', 'Oficina Atualizada ' + ts);",
                  "pm.collectionVariables.set('telefoneAtualizado', rnd());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "var j = pm.response.json();",
                  "",
                  "pm.test('Retornou id e nasceu ativa', function () {",
                  "    pm.expect(j).to.have.property('id');",
                  "    pm.expect(j.ativo).to.eql(true);",
                  "});",
                  "",
                  "pm.test('Nome confere', function () {",
                  "    pm.expect(j.nome).to.eql(pm.collectionVariables.get('nomeUnico'));",
                  "});",
                  "",
                  "pm.collectionVariables.set('oficinaId', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/oficina",
            "description": "Gera nome e telefone unicos a cada rodada e guarda o id em {{oficinaId}}.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeUnico}}\",\n  \"endereco\": \"Rua das Flores, 200\",\n  \"telefone\": \"{{telefoneUnico}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "03 - Buscar por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Id confere', function () {",
                  "    pm.expect(pm.response.json().id).to.eql(parseInt(pm.collectionVariables.get('oficinaId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/oficina/{{oficinaId}}",
            "description": ""
          }
        },
        {
          "name": "04 - Atualizar (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var j = pm.response.json();",
                  "",
                  "pm.test('Dados atualizados', function () {",
                  "    pm.expect(j.nome).to.eql(pm.collectionVariables.get('nomeAtualizado'));",
                  "    pm.expect(j.endereco).to.eql('Av. Brasil, 1500');",
                  "});",
                  "",
                  "pm.test('Id e ativo preservados', function () {",
                  "    pm.expect(j.id).to.eql(parseInt(pm.collectionVariables.get('oficinaId')));",
                  "    pm.expect(j.ativo).to.eql(true);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/oficina/{{oficinaId}}",
            "description": "Atualiza os dados cadastrais; nao altera id nem ativo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeAtualizado}}\",\n  \"endereco\": \"Av. Brasil, 1500\",\n  \"telefone\": \"{{telefoneAtualizado}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "05 - Atualizar mantendo o proprio nome e telefone",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Endereco atualizado', function () {",
                  "    pm.expect(pm.response.json().endereco).to.eql('Rua Nova, 10');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/oficina/{{oficinaId}}",
            "description": "A oficina nao pode conflitar consigo mesma.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeAtualizado}}\",\n  \"endereco\": \"Rua Nova, 10\",\n  \"telefone\": \"{{telefoneAtualizado}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "06 - Desativar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 204 No Content', function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/api/oficina/{{oficinaId}}/desativar",
            "description": ""
          }
        },
        {
          "name": "07 - Atualizar oficina inativa (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 409 Conflict', function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('Mensagem cita \"inativa\"', function () {",
                  "    pm.expect(pm.response.json().message).to.include('inativa');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/oficina/{{oficinaId}}",
            "description": "Regra: oficina inativa nao pode ser editada.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"{{nomeAtualizado}}\",\n  \"endereco\": \"Av. Brasil, 1500\",\n  \"telefone\": \"{{telefoneAtualizado}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "08 - Listar: desativada nao aparece",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Oficina desativada fora da lista', function () {",
                  "    var ids = pm.response.json().map(function (o) { return o.id; });",
                  "    pm.expect(ids).to.not.include(parseInt(pm.collectionVariables.get('oficinaId')));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/oficina",
            "description": ""
          }
        },
        {
          "name": "09 - Buscar desativada por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('ativo é false', function () {",
                  "    pm.expect(pm.response.json().ativo).to.eql(false);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/oficina/{{oficinaId}}",
            "description": "A inativa continua acessivel por id."
          }
        },
        {
          "name": "10 - Ativar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code é 204 No Content', function () {",
