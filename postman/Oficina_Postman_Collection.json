{
  "info": {
    "name": "CarToon - Oficina API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Rode na ordem (Runner). Pré-requisitos: banco no ar, API com perfil dev, e a variável 'password' preenchida com a senha do log."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/oficina"
    },
    {
      "key": "username",
      "value": "user"
    },
    {
      "key": "password",
      "value": "cole-a-senha-do-log-aqui"
    },
    {
      "key": "oficinaId",
      "value": "1"
    },
    {
      "key": "nomeGrande",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "A - Fluxo feliz (rodar em ordem)",
      "item": [
        {
          "name": "01 - Listar (seeder criou id 1)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Retorna um array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Tem ao menos 1 oficina (seeder dev)', () => pm.expect(pm.response.json().length).to.be.above(0));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}",
            "description": "Exige o perfil dev ativo para o seeder ter criado a oficina id 1."
          }
        },
        {
          "name": "02 - Criar oficina válida",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('Tem id', () => pm.expect(j).to.have.property('id'));",
                  "pm.test('Nasce ativa', () => pm.expect(j.ativo).to.eql(true));",
                  "pm.test('Dados conferem', () => { pm.expect(j.nome).to.eql('Oficina Centro'); pm.expect(j.endereco).to.eql('Rua das Flores, 200'); });",
                  "pm.collectionVariables.set('oficinaId', j.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Oficina Centro\",\n  \"endereco\": \"Rua das Flores, 200\",\n  \"telefone\": \"11988887777\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "03 - Buscar por id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Id confere', () => pm.expect(pm.response.json().id).to.eql(parseInt(pm.collectionVariables.get('oficinaId'))));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{oficinaId}}",
            "description": ""
          }
        },
        {
          "name": "04 - Atualizar (PUT)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('Nome atualizado', () => pm.expect(j.nome).to.eql('Oficina Centro Atualizada'));",
                  "pm.test('Endereço atualizado', () => pm.expect(j.endereco).to.eql('Av. Brasil, 1500'));",
                  "pm.test('Id e ativo preservados', () => { pm.expect(j.id).to.eql(parseInt(pm.collectionVariables.get('oficinaId'))); pm.expect(j.ativo).to.eql(true); });"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/{{oficinaId}}",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Oficina Centro Atualizada\",\n  \"endereco\": \"Av. Brasil, 1500\",\n  \"telefone\": \"11977776666\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "05 - Desativar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/{{oficinaId}}/desativar",
            "description": ""
          }
        },
        {
          "name": "06 - Listar: oficina desativada NÃO aparece",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Oficina desativada fora da lista', () => {",
                  "  const id = parseInt(pm.collectionVariables.get('oficinaId'));",
                  "  pm.expect(pm.response.json().map(o => o.id)).to.not.include(id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}",
            "description": ""
          }
        },
        {
          "name": "07 - Buscar por id: desativada continua acessível",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('ativo = false', () => pm.expect(pm.response.json().ativo).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/{{oficinaId}}",
            "description": ""
          }
        },
        {
          "name": "08 - Ativar",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/{{oficinaId}}/ativar",
            "description": ""
          }
        },
        {
          "name": "09 - Listar: oficina reativada volta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "pm.test('Oficina reativada na lista', () => {",
                  "  const id = parseInt(pm.collectionVariables.get('oficinaId'));",
                  "  pm.expect(pm.response.json().map(o => o.id)).to.include(id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}",
            "description": ""
          }
        }
      ]
    },
