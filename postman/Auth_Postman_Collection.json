		{
			"name": "4. Tentar Login com Senha Incorreta",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code indica credenciais inválidas (401 ou 403)', function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([401, 403]);",
							"});",
							"",
							"pm.test('Não emite cookie de autenticação JWT válido', function () {",
							"    var setCookie = pm.response.headers.get('Set-Cookie');",
							"    if (setCookie) {",
							"        pm.expect(setCookie).to.not.include('jwt=ey');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
