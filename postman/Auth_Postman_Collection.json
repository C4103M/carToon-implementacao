		{
			"name": "6. Logout",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code é 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Header Set-Cookie limpa o cookie JWT (Max-Age=0)', function () {",
							"    var setCookie = pm.response.headers.get('Set-Cookie');",
							"    pm.expect(setCookie).to.be.a('string');",
							"    pm.expect(setCookie).to.include('jwt=');",
							"    pm.expect(setCookie).to.include('Max-Age=0');",
							"});"
						],
						"type": "text/javascript"
