          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/clientes",
        "description": "CPF continua reservado pelo cliente inativo; é preciso reativá-lo.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Cliente Soft Delete\",\n  \"cpf\": \"{{cpf}}\",\n  \"telefone\": \"11999990000\",\n  \"endereco\": \"Rua Teste, 100\",\n  \"oficinaId\": {{oficinaId}}\n}",
