            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('nome atualizado', function () { pm.expect(pm.response.json().nome).to.eql('Cliente Reativado'); });"
            ]
          }
        }
      ]
    },
