          "mode": "raw",
          "raw": "{\n  \"nome\": \"Cliente Reativado\",\n  \"cpf\": \"{{cpf}}\",\n  \"telefone\": \"11999990000\",\n  \"endereco\": \"Rua Teste, 100\",\n  \"oficinaId\": {{oficinaId}}\n}",
