          "mode": "raw",
          "raw": "{\n  \"veiculoId\": {{veiculoId}},\n  \"oficinaId\": {{oficinaId}},\n  \"mecanicoId\": {{mecanicoId}},\n  \"descricao\": \"OS de teste - bloqueio de desativação\"\n}",
