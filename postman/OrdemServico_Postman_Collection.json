			"name": "1. Criar Ordem de Serviço",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('Status code é 201 Created ou 200 OK', function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
							"});",
							"",
							"pm.test('Retornou ID da Ordem de Serviço', function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('id');",
							"    if (jsonData.id) {",
							"        pm.collectionVariables.set('ordemId', jsonData.id);",
							"        console.log('OrdemID salva na variável: ' + jsonData.id);",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"veiculoId\": 1,\n  \"oficinaId\": 1,\n  \"mecanicoId\": 1,\n  \"descricao\": \"Troca de óleo e alinhamento\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}",
					"host": [
						"{{baseUrl}}"
					]
				},
				"description": "Cria uma nova Ordem de Serviço e armazena o ID retornado na variável {{ordemId}}."
			},
			"response": []
		},
